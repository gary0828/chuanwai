# ════════════════════════════════════════════════════════════════════
# AI 读取排除清单 · .aiignore
# ────────────────────────────────────────────────────────────────────
# 目的：项目磁盘占用 809MB，但真实源码只有约 31,000 行（≈5MB，占 0.6%）。
#       本清单把「依赖 / 构建产物 / 数据库 / 截图 / 锁文件」挡在上下文之外，
#       避免 AI 助手每次会话浪费数万 token 读取无意义内容。
#
# 效果：809MB → 约 5MB（99.4% 的体积被排除）
#
# 用法：Cursor / Trae / Copilot / Gemini CLI / 通用 AI 工具均支持或兼容此文件。
#       同内容副本：.cursorignore、.copilotignore、.ignore（ripgrep/fd 用）
#
# ⚠️ 注意：以下目录是**源码**，已在下方显式保留（! 开头），切勿误排除：
#       build/          vite 构建配置（6 个 .ts）
#       mock/ public/ types/   前端运行时资源与类型定义
#       .workbuddy/     AI 记忆（会话开始时需读取）
# ════════════════════════════════════════════════════════════════════

# ── 1. 第三方依赖（约 791MB，占项目 97%）──────────────────────────
node_modules/
server/node_modules/
**/node_modules/

# ── 2. 构建产物（4MB）────────────────────────────────────────────
dist/
dist-ssr/
*.map
*.min.js
*.chunk.js

# ── 3. 数据库与备份（7MB，二进制；含真实学员数据，也不应进上下文）──
server/data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.db.bak*

# ── 4. 锁文件（240KB+1MB 的超长 JSON/YAML，AI 几乎从不需读全文）────
pnpm-lock.yaml
package-lock.json
yarn.lock

# ── 5. 截图与测试产物（6MB）───────────────────────────────────────
evidence/
_verify_test/
playwright-report/
coverage/

# ── 6. 二进制资源（图片 / 字体 / 音视频，AI 读文本无意义）──────────
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.webp
*.bmp
*.woff
*.woff2
*.ttf
*.eot
*.mp4
*.webm
# 例外：矢量图标体积小且常需参考，保留 .svg

# ── 7. 第三方前端库源码（29KB，非本项目逻辑，且易引发构建告警）──────
src/assets/iconfont/iconfont.js

# ── 8. 版本控制与编辑器配置 ────────────────────────────────────────
.git/
.vscode/
.trae/
.idea/
.DS_Store

# ── 9. 日志与临时文件 ──────────────────────────────────────────────
*.log
*.tmp
*.temp
.cache/
.temp/

# ════════════════════════════════════════════════════════════════════
# 显式保留（覆盖上面的通配规则）
# ════════════════════════════════════════════════════════════════════
!build/**
!mock/**
!public/**
!types/**
!docs/**
!src/**
!server/src/**
!.workbuddy/**
!*.md
