# 前端环境变量示例（复制为 .env / .env.production 后按需修改）
# 所有自定义环境变量必须以 VITE_ 开头（pure-admin 规范，见 WORKBUDDY.md §0.2-F）

# 开发服务器端口
VITE_PORT = 8848

# 打包后的基础路径（部署在子目录时才需要改）
VITE_PUBLIC_PATH = /

# 路由模式：hash | history
VITE_ROUTER_HISTORY = hash

# 是否启用 CDN 加速（true / false）
VITE_CDN = false

# 打包压缩：none | gzip | brotli
VITE_COMPRESSION = none

# 登录页图形验证码开关（true / false）
# 设为 false 的场景：跑 Playwright 自动化验证脚本时（脚本无法识别 canvas 验证码）
# 生产环境请保持 true
VITE_LOGIN_CAPTCHA = true
