# 后端环境变量模板
#
# 用法：复制为 server/.env 后按需修改。
#   cp server/.env.example server/.env
#
# ⚠️ server/.env 已被根目录 .gitignore 的 `.env*` 规则排除，切勿把真实密钥提交到仓库。
# ⚠️ 本模板只放占位值，真实值一律通过环境变量 / Docker Compose / 密钥管理系统注入。
#
# 完整说明见 README.md「快速开始 → 方式一：Docker 部署」与
# docs/上线评估报告-2026-09-12.md 问题 B1。

# ── JWT 签名密钥（必填）────────────────────────────────────────────
# 双 Token（accessToken 7d + refreshToken 30d）的签名密钥。
#
# 不设置时的行为：拒绝启动并打印中文指引（server/src/config.js 在应用启动时校验，
# 早于建表与迁移，避免「配置非法却已污染数据库」）。
# 历史提示：修复前该模块会回退到源码硬编码的公开默认值 "attendance-secret-key-change-me"，
# 任何拿到源码的人都能自签 role:"admin" 的 token 读取全部学员 / 家长电话 / 缴费金额。
# 该回退已移除，Docker 部署由 docker-compose.yml 的 ${JWT_SECRET:?...} 强制注入。
#
# 生成方式：
#   Linux/macOS : openssl rand -hex 32
#   Windows PS  : [Convert]::ToHexString((1..32|%{Get-Random -Max 256})) -replace '-',''
#
# 轮换提示：更换此值会使所有已签发的 access/refresh token 立即失效，
#           需通知全体员工重新登录，建议在非教学时段执行。
JWT_SECRET=please-generate-with-openssl-rand-hex-32

# ── 服务监听端口（可选）────────────────────────────────────────────
# 默认 3000（server/src/index.js）。Docker 部署时由 docker-compose.yml 注入。
PORT=3000

# ── CORS 来源白名单（可选，逗号分隔）──────────────────────────────────
# 默认放行本机开发端口（8080 / 8848）。
# 生产部署下前端页面与 API 同源（nginx 反代 /api），不经过 CORS 校验，
# 因此通常无需设置；仅当需要「浏览器直接访问 :3000」时才追加实际来源。
# CORS_ORIGINS=http://localhost:8080,http://192.168.1.10:8080

# ── 登录失败限速（可选）──────────────────────────────────────────────
# 同一 IP 在 15 分钟窗口内允许的登录「失败」次数，默认 10。
# 成功登录不计数（skipSuccessfulRequests），因此不会误伤正常员工。
# 自动化测试若需频繁验证错误口令场景，可临时调大。
# LOGIN_RATE_LIMIT_MAX=10

# ── 说明：本文件如何被读取 ───────────────────────────────────────────
# 后端不依赖 dotenv，而是使用 Node 原生 `--env-file-if-exists=.env`
# （见 server/package.json 的 start / dev 脚本），因此：
#   · 本地开发：复制本文件为 server/.env 即自动生效
#   · Docker：由 docker-compose.yml 的 environment 注入（优先级更高）
#   · 直接运行：可在 shell 中 export JWT_SECRET=... 后执行 node src/index.js
